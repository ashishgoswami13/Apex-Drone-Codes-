# Override GitHub language detection
*.py linguist-language=Python linguist-detectable=true
drone_*.py linguist-language=Python linguist-detectable=true

# Exclude HTML files from language statistics (mark as vendored)
*.html linguist-vendored=true
*.htm linguist-vendored=true

# Mark documentation files
*.md linguist-documentation=true
README.md linguist-documentation=true

# Exclude TeX files from language statistics
*.tex linguist-vendored=true
*.cls linguist-vendored=true
*.sty linguist-vendored=true
*.aux linguist-vendored=true
*.log linguist-vendored=true
*.fls linguist-vendored=true
*.fdb_latexmk linguist-vendored=true
*.toc linguist-vendored=true
*.out linguist-vendored=true
*.bbl linguist-vendored=true
*.blg linguist-vendored=true

# Set line endings for Python files
*.py text eol=lf

# If you have specific files that are misdetected, override them:
# filename.extension linguist-language=Python
