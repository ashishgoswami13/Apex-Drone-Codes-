# Override GitHub language detection
*.py linguist-language=Python
*.md linguist-documentation
README.md linguist-documentation

# Mark any TeX files as documentation (if you have any)
*.tex linguist-documentation
*.cls linguist-documentation
*.sty linguist-documentation

# Force Python as the main language
*.py text eol=lf
drone_*.py linguist-language=Python

# If you have any non-standard Python files, specify them:
# some_file linguist-language=Python
